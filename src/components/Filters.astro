---
// Barra de filtros (categoria / subcategoria / tipo).
// Os <select> são populados no cliente a partir dos produtos.
---

<section class="filters-section" aria-label="Busca e filtros de produtos">
  <h2>🔍 Buscar e filtrar</h2>
  <div class="search-box">
    <label class="sr-only" for="busca-produtos">Buscar produtos</label>
    <svg class="search-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
      <circle cx="11" cy="11" r="7" fill="none" stroke="currentColor" stroke-width="2.4" />
      <line x1="16.5" y1="16.5" x2="21" y2="21" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" />
    </svg>
    <input
      type="search"
      id="busca-produtos"
      placeholder="Buscar por nome, categoria ou tipo…"
      autocomplete="off"
      spellcheck="false"
    />
    <button type="button" id="btn-limpar-busca" aria-label="Limpar busca">✖</button>
  </div>
  <div class="filters-grid">
    <div class="filter-group">
      <label for="filtro-categoria">Categoria</label>
      <select id="filtro-categoria" aria-label="Filtrar por categoria">
        <option value="">Todas as categorias</option>
      </select>
    </div>
    <div class="filter-group">
      <label for="filtro-subcategoria">Subcategoria</label>
      <select id="filtro-subcategoria" aria-label="Filtrar por subcategoria">
        <option value="">Todas as subcategorias</option>
      </select>
    </div>
    <div class="filter-group">
      <label for="filtro-tipo">Tipo</label>
      <select id="filtro-tipo" aria-label="Filtrar por tipo">
        <option value="">Todos os tipos</option>
      </select>
    </div>
    <button id="btn-limpar-filtros" title="Remover todos os filtros">
      ✖ Limpar filtros
    </button>
  </div>
</section>
