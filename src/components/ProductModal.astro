---
// Modal de seleção de tamanho/cor. Conteúdo montado no cliente.
---

<div id="modal-overlay" role="presentation" aria-hidden="true"></div>

<div
  id="modal-produto"
  role="dialog"
  aria-modal="true"
  aria-labelledby="modal-produto-titulo"
>
  <button id="btn-fechar-modal" aria-label="Fechar">✕</button>
  <div class="modal-corpo">
    <div class="modal-imagem">
      <img id="modal-produto-imagem" src="" alt="" />
    </div>
    <div class="modal-info">
      <h3 id="modal-produto-titulo"></h3>
      <div class="modal-preco"><small>R$</small><span id="modal-produto-preco"></span></div>
      <div class="modal-opcoes" id="modal-opcoes-tamanho">
        <label>Tamanho</label>
        <div class="opcoes-lista" id="lista-tamanhos" role="radiogroup" aria-label="Selecione o tamanho"></div>
      </div>
      <div class="modal-opcoes" id="modal-opcoes-cor">
        <label>Cor</label>
        <div class="opcoes-lista" id="lista-cores" role="radiogroup" aria-label="Selecione a cor"></div>
      </div>
      <p id="modal-aviso" class="modal-aviso" role="alert" aria-live="polite"></p>
      <button id="btn-confirmar-opcoes" type="button">🛒 Adicionar ao Carrinho</button>
    </div>
  </div>
</div>
