---
// Header fixo com logo + botão carrinho.
---

<header>
  <div class="header-inner">
    <div class="logo-area">
      <img src="imagens/logo.png" alt="Logotipo da Palhaçaria & Cia" />
      <span class="logo-text">Palhaçaria <span class="logo-amp">&amp; Cia</span></span>
    </div>
    <button id="btn-abrir-carrinho" aria-label="Abrir carrinho de compras">
      <span class="cart-icon">🛒</span>
      Carrinho
      <span id="contador-carrinho" style="display:none">0</span>
    </button>
  </div>
</header>
