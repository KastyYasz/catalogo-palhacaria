        <li><a href="#" data-filtro-cat="máscara" data-filtro-sub="fofão">Máscaras de Fofão</a></li>
        <li><a href="#" data-filtro-cat="fantasia" data-filtro-sub="palhaço">Fantasias de Palhaço</a></li>
        <li><a href="#" data-filtro-cat="fantasia" data-filtro-sub="fofão">Fantasias de Fofão</a></li>
        <li><a href="#" data-limpar-filtros="1">Ver tudo</a></li>
